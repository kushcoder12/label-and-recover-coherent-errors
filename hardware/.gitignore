# Credentials — NEVER commit
.env

# Generated data / results (raw JSONs, job ids, manifests, analysis).
# The offline dress-rehearsal output (data/) is regenerated by run_all.py and not kept.
data/*.json
online_data/*.json
# The ibm_marrakesh run itself is kept, so the analysis is reproducible from a fresh clone.
!online_data/raw_results.json
!online_data/analysis.json
!online_data/run_manifest.json
!online_data/job_ids.json

# Python
__pycache__/
*.pyc
.DS_Store
